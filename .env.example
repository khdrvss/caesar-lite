# Separate Telegram bot from @BotFather. Never run two pollers on the same token.
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric chat IDs. Include your private-chat ID to enable DMs.
ALLOWED_CHAT_IDS=
BOT_NAME=caesar

# Your chosen HTTPS provider, including its API version prefix (usually /v1).
# It must support chat/completions with function tools. No provider is selected.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Single web-search service: https://app.tavily.com/
TAVILY_API_KEY=

# Optional: enable only for a vision-capable LLM_MODEL.
ENABLE_PHOTOS=false
# Optional: transcription model on the same LLM_BASE_URL, otherwise voice is off.
TRANSCRIPTION_MODEL=
